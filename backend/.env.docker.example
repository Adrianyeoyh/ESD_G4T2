# ── Shared Docker environment variables ─────────────────────────────────────
# Loaded by docker-compose.yml for all services. Overrides per-service .env
# files which use localhost URLs for local development.

APP_ENV=docker

# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=USER
DB_PASSWORD=PASSWORD
DB_NAME=esd_db

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE=notification.payment.success

# ── Internal service URLs (Docker DNS hostnames) ───────────────────────────
INVOICE_SERVICE_URL=http://invoice_service:5003
PAYMENT_SERVICE_URL=http://payment_service:5004
DRUG_CATALOGUE_URL=http://drug_catalogue_service:5001
PRESCRIPTION_SERVICE_URL=http://prescription_service:5005
MAKE_PAYMENT_SERVICE_URL=http://make_payment:5008

# ── External service URLs (OutSystems) ─────────────────────────────────────
RECORDS_SERVICE_URL=YOUR_RECORDS_SERVICE_URL
PATIENT_SERVICE_URL=YOUR_PATIENT_SERVICE_URL

# ── Shared secrets ─────────────────────────────────────────────────────────
INTERNAL_API_KEY=changeme-dev-key

# ── Twilio Configuration (Added for Notification Service) ──────────────────
TWILIO_ACCOUNT_SID=ACyour_actual_sid_here
TWILIO_AUTH_TOKEN=your_actual_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ── Stripe Configuration (For Payment Service) ───────────────────────────
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx